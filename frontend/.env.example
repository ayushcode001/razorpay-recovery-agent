# Base URL of the backend API (Render deployment or local server)
# In local development with Vite dev server proxying /api, this can be left blank.
# In production on Vercel, set this to your Render service URL, e.g.:
# VITE_API_BASE_URL=https://razorpay-recovery-agent.onrender.com
VITE_API_BASE_URL=

# Razorpay Test Mode Key ID (for client-side Razorpay Checkout modal)
VITE_RZP_KEY_ID=rzp_test_TXGN9f3OcY29Zu

# Basic Auth credentials (required if DASHBOARD_USERNAME & DASHBOARD_PASSWORD are set on backend)
VITE_API_USERNAME=
VITE_API_PASSWORD=
