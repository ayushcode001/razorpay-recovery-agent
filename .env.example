# Razorpay Test Mode API Credentials
# Get these from https://dashboard.razorpay.com/ -> Account & Settings -> API Keys (Toggle Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Razorpay Webhook Secret (Set this when configuring Webhook in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Google Gemini API Key for Audit Trail Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# Managed PostgreSQL Database URL (Render auto-injects this when linked)
DATABASE_URL=postgresql://recovery_user:secret@dpg-xxxx.render.com/recovery_db

# Basic Authentication for Dashboard and APIs
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=recovery_admin_pass

# Optional: Custom Email Notifications for reprompt_customer / change_method
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
